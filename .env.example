# App
NEXT_PUBLIC_APP_NAME=Adone AI
NEXT_PUBLIC_APP_DOMAIN=https://adoneintelligence.com.br
SITE_URL=https://adoneintelligence.com.br

# E-mail SMTP (Hostinger)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=contato@adoneintelligence.com.br
EMAIL_PASS=sua_senha_aqui

# Destinatário dos leads
RECIPIENT_EMAIL=contato@adoneintelligence.com.br
RECIPIENT_NAME=Adone AI

# SEO — Verificação de site (opcional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=seu_codigo_google
# NEXT_PUBLIC_YANDEX_VERIFICATION=seu_codigo_yandex
# NEXT_PUBLIC_YAHOO_VERIFICATION=seu_codigo_yahoo


# Segurança de webhooks / automações
WEBHOOK_SECRET=um_segredo_forte_para_chamadas_automaticas

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=seu_client_id_linkedin
LINKEDIN_CLIENT_SECRET=seu_client_secret_linkedin

# LinkedIn publishing
# Preencha após concluir o fluxo em /api/linkedin/connect
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_MEMBER_ID=
LINKEDIN_ORG_ID=

# Chatbot Vick (OpenAI)
OPENAI_API_KEY=sua_chave_openai
OPENAI_MODEL=gpt-6-luna
# Opcional: padrão é SITE_URL + /agendar
# BOOKING_URL=https://adoneintelligence.com.br/agendar

# WhatsApp (Z-API)
ZAPI_INSTANCE=id_da_instancia
ZAPI_TOKEN=token_da_instancia
ZAPI_CLIENT_TOKEN=token_de_seguranca_da_conta
# Segredo do webhook: cadastre na Z-API como /api/webhooks/whatsapp?secret=<valor>
ZAPI_WEBHOOK_SECRET=um_segredo_longo_e_aleatorio

# Google (Agenda + Planilha de leads/agendamentos)
# Gere com: node scripts/google-auth.mjs (preenche REFRESH_TOKEN e SHEET_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=primary

# Medição (fase 0 de marketing) — lidas no build; vazias = sem tags e sem aviso de cookies
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=

# Agentes de marketing (Estrategista: gpt-6-astra; Conteúdo: gpt-6-sol) — usam a mesma OPENAI_API_KEY da Vick
# true liga as rotinas semanais (seg 7h Estrategista, ter 7h Conteúdo) no servidor de produção
MARKETING_AGENTS_ENABLED=false
# WhatsApp que recebe os avisos de aprovação (DDD + número)
MARKETING_NOTIFY_PHONE=
# Opcionais
# MARKETING_STRATEGY_MODEL=gpt-6-astra
# MARKETING_CONTENT_MODEL=gpt-6-sol
# MARKETING_ARTICLES_PER_RUN=2
# Imagens do blog (gpt-image) e publicação automática (vai ao ar após N horas sem veto)
# MARKETING_IMAGE_MODEL=gpt-image-2.5-flare
# MARKETING_PUBLISH_DELAY_HOURS=24
# Pasta "Adone — Blog" no Drive (criada por node scripts/google-auth.mjs)
GOOGLE_DRIVE_FOLDER_ID=

# Painel /painel
PAINEL_PASSWORD=uma_senha_longa_e_aleatoria
# ID numérico da propriedade GA4 (Administrador → Detalhes da propriedade)
GA4_PROPERTY_ID=

# LinkedIn Insight Tag e conversões (Campaign Manager) — lidas no build
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_LEAD=
NEXT_PUBLIC_LINKEDIN_CONVERSION_BOOKING=
NEXT_PUBLIC_LINKEDIN_CONVERSION_WHATSAPP=
