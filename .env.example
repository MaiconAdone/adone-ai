# WhatsApp (Z-API)
ZAPI_INSTANCE=id_da_instancia
ZAPI_TOKEN=token_da_instancia
ZAPI_CLIENT_TOKEN=token_de_seguranca_da_conta
# Segredo do webhook: cadastre na Z-API como /api/webhooks/whatsapp?secret=<valor>
ZAPI_WEBHOOK_SECRET=um_segredo_longo_e_aleatorio

# CRM (opcional)
HUBSPOT_API_KEY=
